[Unit]
Description=OfficeTools Yosuaf — Elysia (Bun) App
After=network.target

[Service]
Type=simple
User=clowniiizzz
WorkingDirectory=/home/clowniiizzz/yosua-portfolio/officetools
Environment=PATH=/home/clowniiizzz/.bun/bin:/usr/bin
ExecStart=/home/clowniiizzz/.bun/bin/bun run server/index.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
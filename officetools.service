[Unit]
Description=OfficeTools Yosuaf — FastAPI App
After=network.target

[Service]
Type=simple
User=clowniiizzz
WorkingDirectory=/home/clowniiizzz/yosua-portfolio/officetools
Environment=PATH=/home/clowniiizzz/yosua-portfolio/officetools/venv/bin:/usr/bin
ExecStart=/home/clowniiizzz/yosua-portfolio/officetools/venv/bin/uvicorn main:app --host 127.0.0.1 --port 3001 --workers 1 --log-level info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
